# ---------------------------------------------------------------------------
# Database — local Postgres shared by the web app and the conductor API
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER@localhost:5432/moh_transit?schema=public"

# ---------------------------------------------------------------------------
# Backend API
# Point the web app at this origin. The Flutter conductor app uses the same
# `/api/v1` routes. Leave NEXT_PUBLIC_USE_MOCK_API=true only to bypass Postgres.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_API_TIMEOUT_MS=15000
NEXT_PUBLIC_USE_MOCK_API=false
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=true

# ---------------------------------------------------------------------------
# Localisation — Sierra Leone (Leone, redenominated SLE)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CURRENCY=SLE
NEXT_PUBLIC_CURRENCY_SYMBOL=Le
NEXT_PUBLIC_LOCALE=en-SL

# ---------------------------------------------------------------------------
# Public support details shown in the UI
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPPORT_EMAIL=support@health.gov.sl
NEXT_PUBLIC_SUPPORT_PHONE=+232 76 000 000

# Flutter conductor app
# Point the scanner at this Next.js origin.
# Example from a device on the same network: http://192.168.0.46:3000
# Demo conductor: CND-001 / Password123
# ---------------------------------------------------------------------------
